{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/ascii.txt",
    "padding": {
      "right": 2
    }
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    "title",

    "separator",

    {
      "type": "os",
      "key": "OS",
      "format": "Arch Linux"
    },

    "kernel",
    "uptime",
    "shell",
    "wm",
    "cpu",
    "memory"
  ]
}
